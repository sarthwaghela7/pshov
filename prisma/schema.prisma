// Prisma Schema — P.Sonkar House of Ventures

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Ventures ----

enum VentureType {
  OWNERSHIP
  COLLABORATED
}

model Venture {
  id                   String      @id @default(cuid())
  name                 String
  oneLiner             String      @map("one_liner")
  sectorTag            String      @map("sector_tag")
  stageTag             String      @map("stage_tag")
  imageUrl             String?     @map("image_url")
  redirectUrl          String?     @map("redirect_url")
  redirectEnabled      Boolean     @default(false) @map("redirect_enabled")
  type                 VentureType
  collaborationTypeTag String?     @map("collaboration_type_tag")
  sortOrder            Int         @default(0) @map("sort_order")
  isArchived           Boolean     @default(false) @map("is_archived")
  isVisible            Boolean     @default(true) @map("is_visible")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("ventures")
  @@index([type, isVisible, isArchived])
  @@index([sortOrder])
}

// ---- Applications (all 4 form types) ----

enum ApplicationType {
  INVESTOR
  JOB
  BUSINESS
  GENERAL
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  ARCHIVED
}

model Application {
  id        String            @id @default(cuid())
  fullName  String            @map("full_name")
  email     String
  phone     String
  city      String
  type      ApplicationType
  formData  Json              @map("form_data")
  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("applications")
  @@index([type, status])
  @@index([createdAt])
}

// ---- Site Settings (key-value store) ----

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ---- Admin Logs ----

model AdminLog {
  id         String   @id @default(cuid())
  adminEmail String   @map("admin_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
  @@index([adminEmail])
  @@index([createdAt])
}

// ---- Admin User ----

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
